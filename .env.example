# ── Database ──────────────────────────────────────────────────────────────
# MySQL connection string used by Drizzle ORM (lib/db.ts, drizzle.config.ts).
#
# MySQL should run directly on the VPS host (not in Docker) — see
# docs/DEPLOYMENT.md for why and how to set it up. Because the app itself
# *does* run inside Docker (docker-compose.yml), it must reach the host via
# the special `host.docker.internal` hostname, not `localhost` — `localhost`
# from inside a container refers to the container itself, not the host.
DATABASE_URL=mysql://armaan_app:password@host.docker.internal:3306/armaan
# If you instead run `npm run dev` / `npm start` directly on the host
# (no Docker for the app), use `localhost` instead:
# DATABASE_URL=mysql://armaan_app:password@localhost:3306/armaan

# ── Admin authentication ─────────────────────────────────────────────────
# Single fixed admin account — no `users` table needed.
#
# ⚠️ IMPORTANT if you deploy with Docker Compose (docker-compose.yml uses
# `env_file: .env`): Compose treats `$` in .env files as variable
# interpolation syntax, same as in compose.yaml — a raw bcrypt hash like
# `$2b$10$abcXYZ...` WILL get silently mangled (parts replaced with empty
# strings), breaking admin login with no obvious error.
# You MUST escape every `$` as `$$` in this file. The command below outputs
# an already-escaped hash, ready to paste as-is:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(h => console.log(h.replace(/\$/g, '\$\$')))" 'your-password'
# (If you run the app with plain `npm start`/pm2 instead of Docker, use the
# hash WITHOUT the extra `$$` escaping instead.)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$$2b$$10$$replace-with-a-real-escaped-bcrypt-hash

# Long random secret used to sign the admin session JWT.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# ── MinIO (file storage) ─────────────────────────────────────────────────
# Hostname only, no protocol.
# - In production (docker-compose.yml): the app and MinIO are containers on
#   the same Docker network, so use the service name "minio" — Docker's
#   internal DNS resolves it automatically.
# - In local dev (no Docker): use "localhost".
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# "true" only if MinIO itself is served over HTTPS directly (rare — usually
# you put a reverse proxy with TLS in front and keep this "false" while the
# proxy talks to MinIO over plain HTTP on the same machine/network).
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=armaan_admin
MINIO_SECRET_KEY=replace-with-a-strong-secret
MINIO_BUCKET=armaan-uploads

# Root credentials for the MinIO server itself (used by the `minio` service in docker-compose.yml).
# In production these should match MINIO_ACCESS_KEY / MINIO_SECRET_KEY above,
# or you can create a separate least-privilege access key for the app later.
MINIO_ROOT_USER=armaan_admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-secret

# ── Public site / company info (safe to expose to the browser) ──────────
# Single source of truth for contact details shown across the site
# (lib/config.ts). Update these instead of hardcoding values in components.
NEXT_PUBLIC_COMPANY_PHONE=05832721251
NEXT_PUBLIC_COMPANY_MOBILE=09123491879
NEXT_PUBLIC_COMPANY_WHATSAPP=09123491879
NEXT_PUBLIC_COMPANY_EMAIL=info@armanco.com
NEXT_PUBLIC_COMPANY_ADDRESS="بجنورد، طالقانی شرقی، مجتمع تجاری آرمانی، طبقه اول، پلاک 41"
NEXT_PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps?q=...&output=embed

NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your-page
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/your-page
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/your-channel
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/your-page

# ── nginx / TLS (production Docker stack only) ───────────────────────────
# Your real domain, no protocol/www (e.g. "armanco.com"). Used by nginx's
# templated config (nginx/templates/app.conf.template) and by
# nginx/init-letsencrypt.sh to request the certificate.
DOMAIN=example.com
# Email Let's Encrypt uses for expiry/security notices about this domain.
CERTBOT_EMAIL=admin@example.com
# Set to 1 temporarily while testing nginx/init-letsencrypt.sh to use Let's
# Encrypt's staging server (untrusted certs, but no rate limits). Set back to
# 0 (or remove) before requesting the real certificate.
CERTBOT_STAGING=0
